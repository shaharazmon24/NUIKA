{
  "rules": {
    ".read": false,
    ".write": false,
    "nuika": {
      ".read": false,
      ".write": false,
      "admins": {
        ".read": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        ".write": false
      },
      "products": {
        ".read": true,
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true"
      },
      "settings": {
        ".read": true,
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true"
      },
      "productPhotos": {
        ".read": true,
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        "$productId": {
          ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/')"
        }
      },
      "events": {
        ".read": true,
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        "$eventId": {
          ".validate": "newData.hasChildren(['date','title'])",
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "place": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "time": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().length <= 600"
          },
          "ctaLabel": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "ctaText": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "image": {
            ".validate": "newData.isString() && newData.val().length <= 600000 && newData.val().beginsWith('data:image/')"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "stockUsed": {
        ".read": true,
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        "$cycle": {
          ".validate": "$cycle.matches(/^[0-9]{10,15}$/)",
          "$productId": {
            ".write": "auth != null && (newData.exists() || root.child('nuika/admins').child(auth.uid).val() === true)",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && (!data.exists() || newData.val() > data.val() || root.child('nuika/admins').child(auth.uid).val() === true)"
          }
        }
      },
      "orders": {
        ".read": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        "$orderId": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || root.child('nuika/admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['name','phone','total','timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 25"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "id": {
            ".validate": "newData.isNumber()"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(new|confirmed|ready|done)$/)"
          },
          "archived": {
            ".validate": "newData.isBoolean()"
          },
          "doneAt": {
            ".validate": "newData.isNumber()"
          },
          "delivery": {
            ".validate": "newData.isString() && newData.val().matches(/^(pickup|delivery)$/)"
          },
          "paymentMethod": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "address": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "items": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          },
          "itemsArr": {
            "$i": {
              ".validate": "newData.hasChildren(['id','name','qty'])",
              "id": {
                ".validate": "newData.isNumber()"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "qty": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500"
              },
              "price": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "kitchen": {
        ".read": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true"
      },
      "finance": {
        ".read": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true",
        "entries": {
          "$entryId": {
            ".validate": "newData.hasChildren(['date','amount','kind'])",
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "kind": {
              ".validate": "newData.isString() && newData.val().matches(/^(expense|income)$/)"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "category": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "supplier": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "hasPhoto": {
              ".validate": "newData.isBoolean()"
            },
            "created": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "photos": {
          "$entryId": {
            ".validate": "newData.isString() && newData.val().length <= 700000"
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "_seeded": {
        ".read": true,
        ".write": "auth != null && root.child('nuika/admins').child(auth.uid).val() === true"
      }
    }
  }
}
